# Copy to .env.production on the host. Never commit the populated file.
APP_ENV=production
LOG_LEVEL=INFO

# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=

# First boot only: creates the first administrator if the identity table is empty.
# Remove both values from the host environment after the first successful bootstrap.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Keep false for administrator-only access until project memberships are provisioned.
AUTHORIZATION_ENFORCED=false

# Optional integrations. Keep blank unless deliberately configured.
GITHUB_REPOSITORY=glad4u7-crypto/project-continue
# GITHUB_TOKEN=
# AI_ENABLED=false
# AI_PROVIDER=mock
# AI_MODEL=mock
