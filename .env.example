# Copy this file to .env for local development.
# Never commit .env or put a real token in this template.

APP_NAME=Project Continue
APP_ENV=development
LOG_LEVEL=INFO

# Local default. In production, set an absolute path on persistent storage.
PROJECT_CONTINUE_DB=.data/project_continue.sqlite3

# Public repositories can be inspected without a token (subject to lower API rate limits).
# Private repositories require a fine-grained token with read-only Contents and Metadata access.
GITHUB_REPOSITORY=glad4u7-crypto/project-continue
# GITHUB_TOKEN=
