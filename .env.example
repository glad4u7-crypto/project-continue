# Optional GitHub integration settings.
# Create a fine-grained token with only the repository permissions you need.
# Never commit your real .env file or paste tokens into source code.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Application settings
APP_ENV=development
APP_NAME=Project Continue
PROJECT_CONTINUE_ENV=development
PROJECT_CONTINUE_DATA_DIR=data
PROJECT_CONTINUE_LOG_LEVEL=INFO
