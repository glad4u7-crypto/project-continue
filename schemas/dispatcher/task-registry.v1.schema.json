{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-continue.invalid/schemas/dispatcher/task-registry.v1.schema.json",
  "title": "Project Continue Fixed Dispatcher Task Registry Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "tasks"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "1.0"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "handler_ref",
          "description",
          "risk",
          "arguments_schema"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "handler_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "risk": {
            "type": "string",
            "enum": [
              "read_only",
              "test_only"
            ]
          },
          "arguments_schema": {
            "type": "object",
            "required": [
              "type",
              "additionalProperties",
              "properties",
              "required"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "additionalProperties": {
                "const": false
              },
              "properties": {
                "type": "object"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
